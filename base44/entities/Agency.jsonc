{
  "name": "Agency",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Agency / office name"
    },
    "credits": {
      "type": "number",
      "default": 0,
      "description": "Agency's pooled credit balance, allocated out to agents"
    }
  },
  "required": [
    "name"
  ]
}