{
  "name": "BrandKit",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Agent profile branding name"
    },
    "agent_name": {
      "type": "string",
      "description": "Agent full name"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "description": "Phone in SA format +27"
    },
    "profile_photo_url": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "logo_url": {
      "type": "string",
      "description": "Company/agency logo URL"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "include_agent_branding": {
      "type": "boolean",
      "default": true,
      "description": "Whether to include agent branding (photo, logo, contact info) in the final video output"
    }
  },
  "required": [
    "name",
    "agent_name"
  ]
}