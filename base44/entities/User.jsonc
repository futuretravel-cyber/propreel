{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "credits": {
      "type": "number",
      "default": 0,
      "description": "Available video credits"
    },
    "agency_id": {
      "type": "string",
      "description": "Agency this user belongs to, if any"
    },
    "agency_role": {
      "type": "string",
      "enum": [
        "owner",
        "agent"
      ],
      "description": "Whether this user owns the agency account or is an agent within it"
    }
  },
  "required": [
    "role"
  ]
}