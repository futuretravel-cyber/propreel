{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "credits": {
      "type": "number",
      "default": 0,
      "description": "Available video credits"
    }
  },
  "required": [
    "role"
  ]
}