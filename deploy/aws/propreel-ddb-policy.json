{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PropReelTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable", "dynamodb:DescribeTable", "dynamodb:UpdateTable",
        "dynamodb:DeleteTable", "dynamodb:GetItem", "dynamodb:PutItem",
        "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:Query",
        "dynamodb:Scan", "dynamodb:BatchGetItem", "dynamodb:BatchWriteItem",
        "dynamodb:UpdateTimeToLive", "dynamodb:DescribeTimeToLive"
      ],
      "Resource": [
        "arn:aws:dynamodb:af-south-1:619924817943:table/propreel-*",
        "arn:aws:dynamodb:af-south-1:619924817943:table/propreel-*/index/*"
      ]
    },
    {
      "Sid": "PropReelAssets",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::propreel-raw-assets",
        "arn:aws:s3:::propreel-raw-assets/*",
        "arn:aws:s3:::propreel-video-outputs-sa",
        "arn:aws:s3:::propreel-video-outputs-sa/*"
      ]
    }
  ]
}
