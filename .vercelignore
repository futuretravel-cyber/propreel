# Upload hygiene — when .vercelignore exists it replaces .gitignore for
# deploy filtering, so the essentials are restated here.

# Dependencies & build output (Vercel installs and builds itself)
node_modules/
dist/
build/
.tsbuildinfo
tsconfig.tsbuildinfo

# Secrets & local env
.env
.env.*
.vercel/

# Local-only material: staging test scripts/artifacts, docs, CI config.
# `scripts/*` (not `scripts/`) so the BUILD GUARDS can be re-included —
# gitignore semantics cannot re-include a file under an excluded directory,
# and `npm run build` runs both guards after `vite build` on the builder
# (a missing guard file fails the remote build with MODULE_NOT_FOUND).
scripts/*
!scripts/check-no-inline-scripts.mjs
!scripts/check-bundle-stealth.mjs
# `npm run chat:index` runs this before `vite build` to regenerate the support
# assistant's knowledge index (lib/chatIndex.json) from the FAQ, blog and docs.
!scripts/build-chat-index.ts
docs/
.github/
.vscode/
.idea/
coverage/
*.log
