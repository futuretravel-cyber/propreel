# Secrets live in Vercel project env + your local .env only. Values below are placeholders.
# ══════════════════════════════════════════════════════════════════
#  PropReel environment template
#  Copy to .env and fill in real values. NEVER put real secrets here.
# ══════════════════════════════════════════════════════════════════

# ── Supabase (auth) ──────────────────────────────────────────────
# Dashboard → Settings → API
VITE_SUPABASE_URL=https://agcchttiomlbuuycwdgy.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── AWS (DynamoDB, af-south-1) ───────────────────────────────────
# IAM user with access limited to propreel-* tables
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_S3_RAW_BUCKET=propreel-raw-assets
AWS_S3_OUTPUT_BUCKET=propreel-video-outputs-sa

# ── Modal (video rendering — browser calls it directly) ──────────
# Must match a DEPLOYED web app; verify with: curl "$VITE_MODAL_ENDPOINT/health"
ITE_MODAL_ENDPOINT=https://api.propreel.co.za/w

