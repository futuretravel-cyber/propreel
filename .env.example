# ══════════════════════════════════════════════════════════════════
#  PropReel environment template
#  Copy to .env and fill in real values. NEVER put real secrets here.
# ══════════════════════════════════════════════════════════════════

# ── Supabase (auth) ──────────────────────────────────────────────
# Dashboard → Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<public anon key — safe for browser>
SUPABASE_SERVICE_ROLE_KEY=<service role key — SERVER ONLY, bypasses RLS>

# ── AWS (DynamoDB, af-south-1) ───────────────────────────────────
# IAM user with access limited to propreel-* tables
AWS_ACCESS_KEY_ID=<access key id, AKIA...>
AWS_SECRET_ACCESS_KEY=<secret access key>
AWS_REGION=af-south-1

# ── Modal (video rendering — browser calls it directly) ──────────
# Must match a DEPLOYED web app; verify with: curl "$VITE_MODAL_ENDPOINT/health"
VITE_MODAL_ENDPOINT=https://<workspace>--<app-name>-web.modal.run

# ── Paystack (payments) ──────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxx
# Plan codes from Paystack dashboard (recreate in live mode when going live):
PAYSTACK_PLAN_STARTER_MONTHLY=PLN_xxx
PAYSTACK_PLAN_STARTER_ANNUAL=PLN_xxx
PAYSTACK_PLAN_ESSENTIAL_MONTHLY=PLN_xxx
PAYSTACK_PLAN_ESSENTIAL_ANNUAL=PLN_xxx
PAYSTACK_PLAN_PROFESSIONAL_MONTHLY=PLN_xxx
PAYSTACK_PLAN_PROFESSIONAL_ANNUAL=PLN_xxx
PAYSTACK_PLAN_PREMIUM_MONTHLY=PLN_xxx
PAYSTACK_PLAN_PREMIUM_ANNUAL=PLN_xxx

# ── Cron protection ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32 — must match Vercel env var
CRON_SECRET=<64-hex-char secret>

# ── Optional (code does not read these on Vercel) ────────────────
# VITE_API_URL=            # leave unset: same-origin /api on Vercel
# NODE_ENV=production      # set automatically by Vercel
